# Nario Labs
Options -Indexes
ErrorDocument 404 /404.php

# Never serve config, includes or raw data
<FilesMatch "^(config(\.sample)?\.php|.*\.sql|.*\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(includes|data)/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
